# OurDAO frontend — Stellar / Soroban configuration
#
# Copy to .env.local and fill in. All values are optional; sensible testnet
# defaults are used when unset (except the contract id, which enables live data).

# Deployed OurDAO contract id (starts with C). Without it the UI runs in a
# read-only "not configured" state.
NEXT_PUBLIC_CONTRACT_ID=

# Soroban RPC endpoint (defaults to public testnet).
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (defaults to "Test SDF Network ; September 2015").
# For mainnet use: "Public Global Stellar Network ; September 2015"
NEXT_PUBLIC_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Optional: IPFS gateway for document metadata (Filecoin-analog content hashes).
# Comma-separated; tried in order, falling back on timeout or non-2xx
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Pinata JWT for pinning uploaded documents. Server-only (deliberately not
# NEXT_PUBLIC_-prefixed) — read by src/app/api/documents/route.ts and never
# sent to the client. Get one free at https://app.pinata.cloud/developers/api-keys.
# Without it, document uploads fail with a visible error rather than silently
# no-opping.
PINATA_JWT=

# OurDAO backend (ourdao-backend) — off-chain indexer + read API. Supplies loan
# history, DAO-wide aggregates, notifications, and the event feed. Defaults to a
# local instance; the UI degrades to on-chain-only reads if it's unreachable.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public site origin (no trailing slash). Used as metadataBase so Open Graph /
# Twitter card image URLs resolve to an absolute address. Defaults to
# http://localhost:3000; set this to the real deployed origin in production so
# shared links render a preview image instead of a bare URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
