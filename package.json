{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:report": "vitest run --coverage --coverage.reporter=text",
    "test:visual": "playwright test",
    "e2e": "playwright test --config=playwright.e2e.config.ts",
    "audit": "audit-ci --config ./audit-ci.jsonc",
    "bundle-size": "node scripts/bundle-size.mjs measure && node scripts/bundle-size.mjs report",
    "depcheck": "depcheck",
    "lhci": "lhci autorun",
    "knip": "knip --no-exit-code",
    "knip:baseline": "node scripts/knip-baseline.mjs",
    "knip:check": "knip --reporter json | node scripts/knip-check.mjs knip-baseline.json",
    "gen:contract": "bash scripts/gen-contract-bindings.sh"
  },
  "dependencies": {
    "@creit.tech/stellar-wallets-kit": "2.7.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^17.1.0",
    "@tanstack/react-query": "^5.104.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "audit-ci": "^7.1.0",
    "axe-core": "^4.14.0",
    "depcheck": "^1.4.7",
    "eslint": "^10",
    "eslint-config-next": "^16.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^30.0.0",
    "knip": "^6.38.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  }
}
