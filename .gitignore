# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local editor directories
.idea/
.vscode/
.cursor/
*.iml

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local dev server log
dev.log

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local design screenshots
shots/

# Generated by scripts/bundle-size.mjs; CI caches the baseline per commit.
bundle-size-current.json
bundle-size-baseline.json
bundle-composition-current.json
bundle-composition-baseline.json

# playwright visual regression (baselines live in test/visual/__screenshots__)
/test-results/
/playwright-report/
